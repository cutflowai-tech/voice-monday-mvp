# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Asterisk ARI ------------------------------------------------------------
# Agent in Docker + Asterisk on the same host: http://host.docker.internal:8088
ASTERISK_ARI_URL=
ASTERISK_ARI_USERNAME=
ASTERISK_ARI_PASSWORD=
ASTERISK_STASIS_APP=voice-monday-agent
# Assistant extension; verify that 777 is unused before applying the route.
ASTERISK_TEST_EXTENSION=777
# file (recommended): TTS audio is written to a folder Asterisk can read.
ASTERISK_PLAYBACK_MODE=file
# Host folder mounted into the ari container (must be readable by Asterisk)
ASTERISK_SOUNDS_HOST_DIR=/usr/share/asterisk/sounds/voice-monday
# The same folder as Asterisk sees it (absolute path, no trailing slash)
ASTERISK_SOUNDS_URI_PREFIX=voice-monday
# Only for ASTERISK_PLAYBACK_MODE=http (experimental)
PUBLIC_MEDIA_BASE_URL=

# --- ElevenLabs ----------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Monday.com ----------------------------------------------------------------
# mock = in-memory fake (default, safe). live = real Monday API.
MONDAY_MODE=mock
MONDAY_API_TOKEN=
MONDAY_API_VERSION=2026-07
MONDAY_BOARD_ID=
MONDAY_GROUP_ID=
# "name" = the item name column (default). A text column id also gets the task text.
MONDAY_TASK_NAME_COLUMN=name
# Column id used for the assignee (see `voice-agent monday-inspect`)
MONDAY_ASSIGNEE_COLUMN=
# people   = a People column; MONDAY_<NAME>_PERSON_ID is the Monday user id
# dropdown = a Dropdown column; MONDAY_<NAME>_PERSON_ID is that name's option id
MONDAY_ASSIGNEE_COLUMN_TYPE=people
MONDAY_MOHAMED_PERSON_ID=
# Optional: more assignees follow the same pattern, e.g. MONDAY_AHMED_PERSON_ID=
# Optional: text column that stores the idempotency key (extra duplicate protection)
MONDAY_IDEMPOTENCY_COLUMN=
# Optional People column for verified requester attribution, e.g. the board's Task From column.
MONDAY_REQUESTER_COLUMN=
# MONDAY_AHMED_REQUESTER_ID=<verified Monday user id>

# --- Infrastructure -------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
DATABASE_URL=sqlite:///data/agent.db

# --- Speech-to-text -------------------------------------------------------------
# small = fast on CPU; medium / large-v3 = better Egyptian Arabic accuracy, slower
WHISPER_MODEL=small
DEFAULT_LANGUAGE=ar
# Read every draft aloud and wait for caller approval before adding tasks to Monday.
REVIEW_BEFORE_SUBMIT=true

# --- Call behaviour -------------------------------------------------------------
CALL_INACTIVITY_TIMEOUT_SECONDS=60
CALL_PREPARATION_TIMEOUT_SECONDS=8

# Explicit caller ID attribution. JSON object mapping numbers/extensions to person keys.
# Leave empty to record an unknown requester. Caller ID is not authentication.
CALLER_DIRECTORY_FILE=
UNKNOWN_CALLER_POLICY=anonymous

# Optional structured conversation model. Without a key, deterministic parsing is used.
AGENT_API_KEY=
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-4.1-mini
AGENT_TIMEOUT_SECONDS=8

# --- Hosted voice agent (ElevenLabs Agent over SIP, extension 778) ---------------
# Bearer secret the agent sends to /agent/tools/* (generate: openssl rand -hex 32).
# Empty = the tool endpoints are disabled.
AGENT_TOOL_SECRET=
# Seconds a spoken task waits for a correction before it is saved.
AGENT_GRACE_SECONDS=2
# Seconds to wait for the Monday item before answering "queued" instead of "created".
AGENT_DONE_WAIT_SECONDS=5
# Public https URL of the Cloudflare Tunnel that reaches this API (only /agent/tools/*).
AGENT_PUBLIC_URL=
# SIP digest credentials the PBX uses towards ElevenLabs (generate both; never reuse).
ELEVENLABS_SIP_USERNAME=
ELEVENLABS_SIP_PASSWORD=
# Identifier the PBX dials: sip:<number>@sip.rtc.elevenlabs.io
ELEVENLABS_SIP_NUMBER=778
# Agent voice/model (the library voice needs a paid ElevenLabs plan).
ELEVENLABS_AGENT_VOICE_ID=L10lEremDiJfPicq5CPh
ELEVENLABS_AGENT_LLM=qwen3-30b-a3b
ELEVENLABS_AGENT_TTS_MODEL=eleven_v4_turbo
# post_tool_speech = the grace window starts after her acknowledgment finishes.
ELEVENLABS_TOOL_EXECUTION_MODE=post_tool_speech
# Keyboard typing while a task is saved (0 = off, 1 = normal, up to 3 = loud).
EL_BRIDGE_TYPING_VOLUME=1.0
# Filled in by `voice-agent el-agent sync`.
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Cloudflare Tunnel token (docker compose --profile agent); exposes only /agent/tools/*.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Jobs -----------------------------------------------------------------------
JOB_MAX_RETRIES=3
JOB_BACKOFF_BASE_SECONDS=2

LOG_LEVEL=INFO
LOG_FORMAT=json
